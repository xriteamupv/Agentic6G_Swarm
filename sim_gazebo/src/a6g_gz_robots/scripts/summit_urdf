#!/usr/bin/env python3
"""Print Robotnik's rbsummit URDF adapted for a6g Gazebo (see a6g_gz_robots.summit)."""

import argparse
import os
import sys

import xacro
from ament_index_python.packages import get_package_share_directory

from a6g_gz_robots.summit import adapt


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--model-name", default="summit_01")
    p.add_argument("--prefix", default="robot_")
    p.add_argument("--namespace", default="robot")
    p.add_argument("--robot", default="rbsummit")
    p.add_argument("-o", "--output", default="-")
    a = p.parse_args()
    path = os.path.join(
        get_package_share_directory("robotnik_description"), "robots", a.robot, f"{a.robot}.urdf.xacro"
    )
    doc = xacro.process_file(
        path, mappings={"prefix": a.prefix, "namespace": a.namespace, "gazebo_ignition": "true"}
    )
    urdf = adapt(doc.toxml(), model_name=a.model_name, prefix=a.prefix)
    out = sys.stdout if a.output == "-" else open(a.output, "w")
    out.write(urdf)


if __name__ == "__main__":
    main()
