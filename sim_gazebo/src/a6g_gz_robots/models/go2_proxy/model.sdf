<?xml version="1.0"?>
<!--
  Kinematic Go2 stand-in (SPEC A1 7.2, Rule 15: no legged dynamics).

  The body floats (gravity off) with base_link 0.31 m above the ground and is driven by
  VelocityControl on /model/<name>/cmd_vel. a6g_gz_go2_shim/cmd_vel_to_sport_sim is the only
  publisher of that topic and applies the real cmd_vel_to_sport limits. OdometryPublisher gives
  the ground truth (/model/<name>/odometry); leg odometry with drift is derived from it by
  a6g_gz_go2_shim/leg_odom_sim. Sensor topics are scoped by the model name (gz default), so
  several proxies coexist; each robot's bridge maps them to the dock's ROS names.
-->
<sdf version="1.9">
  <model name="go2_proxy">
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>15.0</mass>
        <inertia>
          <ixx>0.32</ixx><iyy>0.82</iyy><izz>0.73</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- 0.70 x 0.31 x 0.40 m envelope: from 0.02 m above the ground to 0.42 m. -->
      <collision name="body">
        <pose>0 0 -0.09 0 0 0</pose>
        <geometry><box><size>0.70 0.31 0.40</size></box></geometry>
      </collision>
      <visual name="trunk">
        <pose>0 0 0.0 0 0 0</pose>
        <geometry><box><size>0.60 0.26 0.13</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="head">
        <pose>0.30 0 0.03 0 0 0</pose>
        <geometry><box><size>0.10 0.20 0.10</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="leg_fl"><pose>0.20 0.12 -0.16 0 0 0</pose><geometry><box><size>0.05 0.05 0.30</size></box></geometry></visual>
      <visual name="leg_fr"><pose>0.20 -0.12 -0.16 0 0 0</pose><geometry><box><size>0.05 0.05 0.30</size></box></geometry></visual>
      <visual name="leg_rl"><pose>-0.20 0.12 -0.16 0 0 0</pose><geometry><box><size>0.05 0.05 0.30</size></box></geometry></visual>
      <visual name="leg_rr"><pose>-0.20 -0.12 -0.16 0 0 0</pose><geometry><box><size>0.05 0.05 0.30</size></box></geometry></visual>

      <!-- L1-like LiDAR on the head: 360 x 90 deg, sparse (18 x 360), 10 Hz, 0.05-30 m. -->
      <sensor name="utlidar" type="gpu_lidar">
        <pose>0.30 0 0.12 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <gz_frame_id>utlidar_lidar</gz_frame_id>
        <lidar>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>18</samples><resolution>1</resolution><min_angle>-0.7854</min_angle><max_angle>0.7854</max_angle></vertical>
          </scan>
          <range><min>0.05</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>

      <!-- RealSense D435-like depth camera, 640 x 480 at 15 Hz. -->
      <sensor name="camera" type="rgbd_camera">
        <pose>0.36 0 0.03 0 0 0</pose>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <gz_frame_id>camera_color_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30</far></clip>
          <depth_camera><clip><near>0.2</near><far>10</far></clip></depth_camera>
        </camera>
      </sensor>

      <sensor name="imu" type="imu">
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <gz_frame_id>imu</gz_frame_id>
        <!-- Orientation in ENU (east = yaw 0), like a magnetometer-aided IMU after declination
             correction; navsat_transform takes its heading from it (SPEC A1 8). -->
        <imu><orientation_reference_frame><localization>ENU</localization></orientation_reference_frame></imu>
      </sensor>

      <!-- Noise-free: a6g_gz_bringup/gnss_noise_sim applies the profile's GNSS noise. -->
      <sensor name="navsat" type="navsat">
        <pose>-0.10 0 0.15 0 0 0</pose>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <gz_frame_id>gnss</gz_frame_id>
      </sensor>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
