# Copy to .env (gitignored) at the repository root, or reuse the course one:
#   cp ../lca-lc-foundations/.env .env
OPENAI_API_KEY='your_openai_api_key_here'

# Optional: LangSmith tracing of the LangGraph agents
# LANGSMITH_API_KEY='your_langsmith_api_key_here'
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=a6g-swarm

# Optional: self-hosted OpenAI-compatible endpoints instead of the cloud model
# A6G_ONBOARD_VLM_URL=http://192.168.123.18:8082/v1
# A6G_ONBOARD_VLM_MODEL=qwen2.5-vl-3b-instruct-q4

# Operator channel token for `a6g arm` / skill servers
# A6G_OPERATOR_TOKEN=change-me
